<?xml version="1.0" encoding="utf-8"?>
<!-- Dark strip with a hairline at the bottom (visible in dark mode) -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <solid android:color="@color/q_strip_line" />
        </shape>
    </item>
    <item android:bottom="1dp">
        <shape>
            <solid android:color="@color/q_strip" />
        </shape>
    </item>
</layer-list>
