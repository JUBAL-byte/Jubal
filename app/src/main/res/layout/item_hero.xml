<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="@dimen/row_pad_h"
    android:paddingTop="8dp"
    android:paddingEnd="@dimen/row_pad_h"
    android:paddingBottom="6dp">

    <FrameLayout
        android:layout_width="@dimen/hero_tile"
        android:layout_height="@dimen/hero_tile">

        <TextView
            android:id="@+id/hero_tile"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:textSize="64sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/hero_icon"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            android:visibility="gone" />
    </FrameLayout>

    <TextView
        android:id="@+id/hero_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:fontFamily="sans-serif-black"
        android:gravity="center"
        android:maxLines="3"
        android:textColor="?attr/colorOnSurface"
        android:textSize="@dimen/hero_title" />

    <TextView
        android:id="@+id/hero_sub"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:background="?attr/selectableItemBackground"
        android:gravity="center"
        android:maxLines="2"
        android:padding="4dp"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textSize="14sp" />

    <LinearLayout
        android:id="@+id/hero_buttons"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:orientation="horizontal" />
</LinearLayout>
