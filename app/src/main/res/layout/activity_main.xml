<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:layoutDirection="rtl">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

    <!-- Thin brand strip: the JUBAL bars and name, on every screen -->
    <LinearLayout
        android:id="@+id/brand_strip"
        android:layout_width="match_parent"
        android:layout_height="@dimen/strip_h"
        android:background="@drawable/bg_strip"
        android:contentDescription="JUBAL"
        android:gravity="center_vertical|left"
        android:layoutDirection="ltr"
        android:orientation="horizontal"
        android:paddingLeft="@dimen/row_pad_h"
        android:paddingBottom="1dp">

        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="@dimen/strip_mark"
            android:adjustViewBounds="true"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_mark" />

        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="@dimen/strip_name"
            android:layout_marginStart="8dp"
            android:adjustViewBounds="true"
            android:importantForAccessibility="no"
            android:src="@drawable/jubal_name" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

    <LinearLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/top_bar"
            android:layout_width="match_parent"
            android:layout_height="@dimen/top_bar_height"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="4dp"
            android:paddingEnd="4dp">

            <ImageButton
                android:id="@+id/back"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="חזרה"
                android:src="@drawable/ic_arrow_back"
                android:visibility="gone"
                app:tint="?attr/colorOnSurface" />

            <TextView
                android:id="@+id/title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:paddingStart="12dp"
                android:paddingEnd="8dp"
                android:textAlignment="viewStart"
                android:fontFamily="sans-serif-black"
                android:textColor="?attr/colorOnSurface"
                android:textSize="@dimen/top_title" />

            <ImageButton
                android:id="@+id/top_action"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:visibility="gone"
                app:tint="?attr/colorOnSurfaceVariant" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/content"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/mini"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:layout_marginBottom="6dp"
            android:clickable="true"
            android:focusable="true"
            android:visibility="gone"
            app:cardBackgroundColor="?attr/colorSurfaceContainerHigh"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="8dp"
                    android:paddingTop="4dp"
                    android:paddingEnd="4dp"
                    android:paddingBottom="4dp">

                    <app.jubal.qeshev.WaveView
                        android:id="@+id/mini_wave"
                        android:layout_width="@dimen/mini_wave_w"
                        android:layout_height="@dimen/mini_wave_h"
                        android:layout_marginStart="6dp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/mini_title"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:textAlignment="viewStart"
                            android:textColor="?attr/colorOnSurface"
                            android:textSize="@dimen/mini_title"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/mini_artist"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:textAlignment="viewStart"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:textSize="@dimen/mini_artist" />
                    </LinearLayout>

                    <ImageButton
                        android:id="@+id/mini_play"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="נגן או השהה"
                        android:src="@drawable/ic_play_arrow_fill"
                        app:tint="?attr/colorOnSurface" />
                </LinearLayout>

                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/mini_progress"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layoutDirection="ltr"
                    android:max="1000"
                    app:indicatorColor="?attr/colorPrimary"
                    app:trackColor="@android:color/transparent"
                    app:trackThickness="2dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.bottomnavigation.BottomNavigationView
            android:id="@+id/nav"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:backgroundTint="?attr/colorSurfaceContainer"
            app:labelVisibilityMode="labeled"
            app:menu="@menu/bottom_nav" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/player_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?android:attr/colorBackground"
        android:clickable="true"
        android:focusable="false"
        android:visibility="gone" />

    </FrameLayout>
    </LinearLayout>

    <!-- Short messages from JUBAL, with its own mark instead of the system's -->
    <LinearLayout
        android:id="@+id/note"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="120dp"
        android:accessibilityLiveRegion="polite"
        android:background="@drawable/bg_note"
        android:elevation="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="10dp"
        android:paddingEnd="18dp"
        android:paddingBottom="10dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="14dp"
            android:adjustViewBounds="true"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_mark" />

        <TextView
            android:id="@+id/note_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:maxLines="3"
            android:textColor="#F2F0EC"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- Opening screen: logo, name and slogan while the app gets ready -->
    <LinearLayout
        android:id="@+id/splash"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_splash"
        android:clickable="true"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <ImageView
            android:id="@+id/splash_logo"
            android:layout_width="@dimen/splash_logo"
            android:layout_height="wrap_content"
            android:adjustViewBounds="true"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_mark" />

        <ImageView
            android:layout_width="@dimen/splash_wordmark"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:adjustViewBounds="true"
            android:contentDescription="@string/brand_full"
            android:src="@drawable/jubal_wordmark" />

        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:indeterminate="true"
            app:indicatorColor="#8C8B89"
            app:indicatorSize="28dp"
            app:trackThickness="3dp" />
    </LinearLayout>
</FrameLayout>
