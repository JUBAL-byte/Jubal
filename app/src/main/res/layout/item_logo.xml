<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/row_pad_h"
    android:layout_marginTop="16dp"
    android:layout_marginEnd="@dimen/row_pad_h"
    android:layout_marginBottom="8dp"
    android:background="@drawable/bg_brand_card"
    android:gravity="center"
    android:orientation="vertical"
    android:paddingStart="22dp"
    android:paddingTop="26dp"
    android:paddingEnd="22dp"
    android:paddingBottom="20dp">

    <ImageView
        android:layout_width="58dp"
        android:layout_height="wrap_content"
        android:adjustViewBounds="true"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_mark" />

    <ImageView
        android:layout_width="140dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:adjustViewBounds="true"
        android:contentDescription="@string/brand_full"
        android:src="@drawable/jubal_wordmark" />

    <TextView
        android:id="@+id/logo_version"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="center"
        android:textColor="#8C8B89"
        android:textSize="12sp" />
</LinearLayout>
