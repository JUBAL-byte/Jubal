<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="rtl"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/top_bar_height"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="4dp">

        <ImageButton
            android:id="@+id/player_close"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="סגור"
            android:src="@drawable/ic_expand_more"
            app:tint="?attr/colorOnSurface" />

        <TextView
            android:id="@+id/player_label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="14sp" />

        <ImageButton
            android:id="@+id/player_more"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="אפשרויות"
            android:src="@drawable/ic_more_vert"
            app:tint="?attr/colorOnSurface" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/player_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="@dimen/player_pad_h"
            android:paddingEnd="@dimen/player_pad_h"
            android:paddingBottom="24dp">

            <app.jubal.qeshev.WaveView
                android:id="@+id/player_wave"
                android:layout_width="@dimen/player_wave_w"
                android:layout_height="@dimen/player_wave_h"
                android:layout_marginTop="@dimen/player_wave_top" />

            <TextView
                android:id="@+id/player_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/player_wave_top"
                android:ellipsize="end"
                android:fontFamily="sans-serif-black"
                android:gravity="center"
                android:maxLines="4"
                android:textColor="?attr/colorOnSurface"
                android:textSize="@dimen/player_title"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/player_artist"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="?attr/selectableItemBackground"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="2"
                android:padding="4dp"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="@dimen/player_artist" />

            <com.google.android.material.slider.Slider
                android:id="@+id/player_seek"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:contentDescription="מיקום בהשמעה"
                android:layoutDirection="ltr"
                android:valueFrom="0"
                android:valueTo="1000"
                app:labelBehavior="gone" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layoutDirection="ltr"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="12dp">

                <TextView
                    android:id="@+id/player_pos"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="start"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/player_dur"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="end"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:layoutDirection="ltr"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/player_prev"
                    android:layout_width="@dimen/control_size"
                    android:layout_height="@dimen/control_size"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="הקודם"
                    android:src="@drawable/ic_skip_previous_fill"
                    app:tint="?attr/colorOnSurface" />

                <ImageButton
                    android:id="@+id/player_back"
                    android:layout_width="@dimen/control_size"
                    android:layout_height="@dimen/control_size"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="10 שניות אחורה"
                    android:src="@drawable/ic_replay_10"
                    app:tint="?attr/colorOnSurface" />

                <com.google.android.material.floatingactionbutton.FloatingActionButton
                    android:id="@+id/player_play"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="12dp"
                    android:contentDescription="נגן או השהה"
                    android:src="@drawable/ic_play_arrow_fill"
                    app:backgroundTint="?attr/colorPrimary"
                    app:elevation="0dp"
                    app:fabCustomSize="@dimen/play_size"
                    app:maxImageSize="@dimen/play_icon"
                    app:tint="?attr/colorOnPrimary" />

                <ImageButton
                    android:id="@+id/player_fwd"
                    android:layout_width="@dimen/control_size"
                    android:layout_height="@dimen/control_size"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="30 שניות קדימה"
                    android:src="@drawable/ic_forward_30"
                    app:tint="?attr/colorOnSurface" />

                <ImageButton
                    android:id="@+id/player_next"
                    android:layout_width="@dimen/control_size"
                    android:layout_height="@dimen/control_size"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="הבא"
                    android:src="@drawable/ic_skip_next_fill"
                    app:tint="?attr/colorOnSurface" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/player_fav"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="אהובים"
                    android:src="@drawable/ic_favorite"
                    app:tint="?attr/colorOnSurfaceVariant" />

                <ImageButton
                    android:id="@+id/player_folder"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="8dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="הוסף לתיקייה"
                    android:src="@drawable/ic_playlist_add"
                    app:tint="?attr/colorOnSurfaceVariant" />

                <ImageButton
                    android:id="@+id/player_download"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="8dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="שמור בטלפון"
                    android:src="@drawable/ic_download"
                    app:tint="?attr/colorOnSurfaceVariant" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/player_speed"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:contentDescription="מהירות"
                    android:text="1×" />
            </LinearLayout>

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/player_autoplay"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="המשך אוטומטי עם המלצות"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/queue_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:paddingBottom="4dp"
                android:text="הבא בתור"
                android:textAlignment="viewStart"
                android:textColor="?attr/colorOnSurface"
                android:textSize="@dimen/header_text"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/queue_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="-16dp"
                android:layout_marginEnd="-16dp"
                android:orientation="vertical" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
